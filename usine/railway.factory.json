{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.factory",
    "watchPatterns": [
      "usine/**",
      "Dockerfile.factory",
      "usine/railway.factory.json",
      "supabase/functions/_shared/fp.ts",
      "supabase/functions/_shared/cover-match.ts"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}
