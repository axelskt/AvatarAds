# Creative Factory — rendu des vidéos finales sur Railway (usine/railway-render.mjs). Même base que render-worker :
# Node 22 + ffmpeg + Chromium embarqué, HyperFrames installé dans l'image (jamais npx au rendu).
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates curl fonts-liberation fonts-noto-color-emoji unzip chromium \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libcups2 libdrm2 libgbm1 libgtk-3-0 \
    libnss3 libx11-xcb1 libxcomposite1 libxdamage1 libxrandr2 xdg-utils \
  && rm -rf /var/lib/apt/lists/*
ENV HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium PUPPETEER_SKIP_DOWNLOAD=1
# HyperFrames : MÊME version que sur le Mac d'Axel (npx → 0.8.96), pas celle épinglée du render-worker (0.7.60, options
# différentes : « Invalid quality », « Unknown flag --timeout »).
WORKDIR /app/hf
RUN npm init -y >/dev/null && npm install --omit=dev hyperframes@0.8.96
COPY render-worker/assets/sfx /app/render-worker/assets/sfx
WORKDIR /app
COPY usine ./usine
# 07/10 : calcul d'empreinte TikTok partagé avec l'edge tiktok-auth (TypeScript lu tel quel par Node, --experimental-strip-types)
COPY supabase/functions/_shared/fp.ts ./supabase/functions/_shared/fp.ts
RUN chown -R node:node /app
ENV NODE_ENV=production HOME=/home/node CF_HF_BIN=/app/hf/node_modules/.bin/hyperframes CF_CACHE=/tmp/cf-cache CF_FPS=60 HYPERFRAMES_EXTRACT_CACHE_DIR=off
USER node
EXPOSE 8080
CMD ["node", "--experimental-strip-types", "usine/railway-render.mjs"]
