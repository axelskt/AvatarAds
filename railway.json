{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.factory",
    "watchPatterns": [
      "usine/**",
      "Dockerfile.factory",
      "railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 5
      }
    }
  }
}